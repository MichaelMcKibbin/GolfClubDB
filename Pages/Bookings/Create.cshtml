@page
@model GolfClubDB.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}

<h1 class="mb-3">Create Booking</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Booking.MemberId">Member (Player 1)</label>
                <select class="form-select" asp-for="Booking.MemberId" asp-items="Model.MemberOptions">
                    <option value="">Select a member</option>
                </select>
                <span asp-validation-for="Booking.MemberId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.BookingDate">Booking Date</label>
                    <input class="form-control" asp-for="Booking.BookingDate" type="date" />
                    <span asp-validation-for="Booking.BookingDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.TeeTime">Tee Time</label>
                    <select class="form-select" asp-for="Booking.TeeTime" id="teeTimeSelect">
                        <option value="">Select a tee time</option>
                        <option value="07:00">7:00 AM</option>
                        <option value="07:15">7:15 AM</option>
                        <option value="07:30">7:30 AM</option>
                        <option value="07:45">7:45 AM</option>
                        <option value="08:00">8:00 AM</option>
                        <option value="08:15">8:15 AM</option>
                        <option value="08:30">8:30 AM</option>
                        <option value="08:45">8:45 AM</option>
                        <option value="09:00">9:00 AM</option>
                        <option value="09:15">9:15 AM</option>
                        <option value="09:30">9:30 AM</option>
                        <option value="09:45">9:45 AM</option>
                        <option value="10:00">10:00 AM</option>
                        <option value="10:15">10:15 AM</option>
                        <option value="10:30">10:30 AM</option>
                        <option value="10:45">10:45 AM</option>
                        <option value="11:00">11:00 AM</option>
                        <option value="11:15">11:15 AM</option>
                        <option value="11:30">11:30 AM</option>
                        <option value="11:45">11:45 AM</option>
                        <option value="12:00">12:00 PM</option>
                        <option value="12:15">12:15 PM</option>
                        <option value="12:30">12:30 PM</option>
                        <option value="12:45">12:45 PM</option>
                        <option value="13:00">1:00 PM</option>
                        <option value="13:15">1:15 PM</option>
                        <option value="13:30">1:30 PM</option>
                        <option value="13:45">1:45 PM</option>
                        <option value="14:00">2:00 PM</option>
                        <option value="14:15">2:15 PM</option>
                        <option value="14:30">2:30 PM</option>
                        <option value="14:45">2:45 PM</option>
                        <option value="15:00">3:00 PM</option>
                        <option value="15:15">3:15 PM</option>
                        <option value="15:30">3:30 PM</option>
                        <option value="15:45">3:45 PM</option>
                        <option value="16:00">4:00 PM</option>
                        <option value="16:15">4:15 PM</option>
                        <option value="16:30">4:30 PM</option>
                        <option value="16:45">4:45 PM</option>
                        <option value="17:00">5:00 PM</option>
                        <option value="17:15">5:15 PM</option>
                        <option value="17:30">5:30 PM</option>
                        <option value="17:45">5:45 PM</option>
                        <option value="18:00">6:00 PM</option>
                    </select>
                    <span asp-validation-for="Booking.TeeTime" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-4">Additional Players</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player2Name">Player 2 Name</label>
                    <input class="form-control" asp-for="Booking.Player2Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player2Handicap">Player 2 Handicap</label>
                    <input class="form-control" asp-for="Booking.Player2Handicap" type="number" min="0" max="54" />
                    <span asp-validation-for="Booking.Player2Handicap" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player3Name">Player 3 Name</label>
                    <input class="form-control" asp-for="Booking.Player3Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player3Handicap">Player 3 Handicap</label>
                    <input class="form-control" asp-for="Booking.Player3Handicap" type="number" min="0" max="54" />
                    <span asp-validation-for="Booking.Player3Handicap" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player4Name">Player 4 Name</label>
                    <input class="form-control" asp-for="Booking.Player4Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player4Handicap">Player 4 Handicap</label>
                    <input class="form-control" asp-for="Booking.Player4Handicap" type="number" min="0" max="54" />
                    <span asp-validation-for="Booking.Player4Handicap" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Auto-fill Player 1 Name with selected member's name
        const memberSelect = document.querySelector('select[asp-for="Booking.MemberId"]');
        const player1NameInput = document.querySelector('input[asp-for="Booking.Player1Name"]');
        
        memberSelect.addEventListener('change', function() {
            if (this.selectedIndex > 0) {
                // Get the selected option text (member name)
                const selectedText = this.options[this.selectedIndex].text;
                player1NameInput.value = selectedText;
            } else {
                player1NameInput.value = '';
            }
        });
    </script>
}
