@page
@model GolfClubDB.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}

<h1 class="mb-3">Create Booking</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Booking.MemberId">Member</label>
                <select class="form-select" asp-for="Booking.MemberId" asp-items="Model.MemberOptions">
                    <option value="">Select a member</option>
                </select>
                <span asp-validation-for="Booking.MemberId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.BookingDate">Booking Date</label>
                    <input class="form-control" asp-for="Booking.BookingDate" type="date" />
                    <span asp-validation-for="Booking.BookingDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.TeeTime">Tee Time</label>
                    <input class="form-control" asp-for="Booking.TeeTime" type="time" step="900" />
                    <span asp-validation-for="Booking.TeeTime" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-4">Additional Players</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player1Name">Player 1 Name</label>
                    <input class="form-control" asp-for="Booking.Player1Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player1Handicap">Player 1 Handicap</label>
                    <input class="form-control" asp-for="Booking.Player1Handicap" type="number" min="0" max="54" />
                    <span asp-validation-for="Booking.Player1Handicap" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player2Name">Player 2 Name</label>
                    <input class="form-control" asp-for="Booking.Player2Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player2Handicap">Player 2 Handicap</label>
                    <input class="form-control" asp-for="Booking.Player2Handicap" type="number" min="0" max="54" />
                    <span asp-validation-for="Booking.Player2Handicap" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player3Name">Player 3 Name</label>
                    <input class="form-control" asp-for="Booking.Player3Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player3Handicap">Player 3 Handicap</label>
                    <input class="form-control" asp-for="Booking.Player3Handicap" type="number" min="0" max="54" />
                    <span asp-validation-for="Booking.Player3Handicap" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player4Name">Player 4 Name</label>
                    <input class="form-control" asp-for="Booking.Player4Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Booking.Player4Handicap">Player 4 Handicap</label>
                    <input class="form-control" asp-for="Booking.Player4Handicap" type="number" min="0" max="54" />
                    <span asp-validation-for="Booking.Player4Handicap" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
