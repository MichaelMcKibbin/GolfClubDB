@page "{id:int}"
@model GolfClubDB.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>Delete Booking</h1>
            <hr />
            
            <div class="alert alert-danger mb-3">
                <strong>Are you sure you want to delete this booking?</strong>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Member</label>
                <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@Model.Booking.Member?.Name</div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Booking Date</label>
                    <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@Model.Booking.BookingDate.ToString("dddd, dd MMMM yyyy")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Tee Time</label>
                    <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@Model.Booking.TeeTime.ToString("HH:mm")</div>
                </div>
            </div>

            <hr />

            <h5>Players</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Player 1 Name</label>
                    <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@Model.Booking.Member?.Name</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Player 1 Handicap</label>
                    <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@Model.Booking.Member?.Handicap</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Booking.Player2Name) || Model.Booking.Player2Handicap.HasValue)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Player 2 Name</label>
                        <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@(string.IsNullOrEmpty(Model.Booking.Player2Name) ? "N/A" : Model.Booking.Player2Name)</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Player 2 Handicap</label>
                        <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@(Model.Booking.Player2Handicap.HasValue ? Model.Booking.Player2Handicap.ToString() : "N/A")</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Booking.Player3Name) || Model.Booking.Player3Handicap.HasValue)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Player 3 Name</label>
                        <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@(string.IsNullOrEmpty(Model.Booking.Player3Name) ? "N/A" : Model.Booking.Player3Name)</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Player 3 Handicap</label>
                        <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@(Model.Booking.Player3Handicap.HasValue ? Model.Booking.Player3Handicap.ToString() : "N/A")</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Booking.Player4Name) || Model.Booking.Player4Handicap.HasValue)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Player 4 Name</label>
                        <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@(string.IsNullOrEmpty(Model.Booking.Player4Name) ? "N/A" : Model.Booking.Player4Name)</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Player 4 Handicap</label>
                        <div class="form-control" style="background-color: #f8f9fa; cursor: default;">@(Model.Booking.Player4Handicap.HasValue ? Model.Booking.Player4Handicap.ToString() : "N/A")</div>
                    </div>
                </div>
            }

            <hr />

            <form method="post" style="display: inline;">
                <button type="submit" class="btn btn-danger">Delete Booking</button>
                <a asp-page="./View" asp-route-id="@Model.Booking.Id" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
