@page
@model GolfClubDB.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bookings</h1>
    <a class="btn btn-primary" asp-page="./Create">Create Booking</a>
</div>

@if (Model.FilteredMember != null)
{
    <div class="alert alert-info mb-3 d-flex justify-content-between align-items-center">
        <span>Showing bookings for: <strong>@Model.FilteredMember.LastName, @Model.FilteredMember.FirstName</strong></span>
        <a class="btn btn-sm btn-outline-secondary" asp-page="./Index">Show All Bookings</a>
    </div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Member</th>
            <th>Date</th>
            <th>Tee Time</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var booking in Model.Bookings)
    {
        <tr style="cursor: pointer;" onclick="window.location.href='@Url.Page("./View", new { id = booking.Id })'">
            <td>@booking.Member?.LastName, @booking.Member?.FirstName</td>
            <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
            <td>@booking.TeeTime.ToString("HH:mm")</td>
        </tr>
    }
    </tbody>
</table>
