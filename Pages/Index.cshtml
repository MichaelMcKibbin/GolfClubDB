@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="home-hero">
    <div>
        <h1>Golf Club Database</h1>
        <p>Manage members and tee time bookings in one place</p>        
    </div>
</div>
<div class="home-link-to-repo">
    <p><a href="https://github.com/MichaelMcKibbin/GolfClubDB" target="_blank">https://github.com/MichaelMcKibbin/GolfClubDB</a></p>
</div>
<div class="home-content">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100" onclick="window.location.href='@Url.Page("/Members/Index")'">
                <div class="card-body">
                    <h5 class="card-title">👥 Members</h5>
                    <p class="card-text">Create, edit, and track membership details with comprehensive profiles.</p>
                    <a class="btn btn-primary" asp-page="/Members/Index">View Members</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100" onclick="window.location.href='@Url.Page("/Bookings/Index")'">
                <div class="card-body">
                    <h5 class="card-title">📅 Bookings</h5>
                    <p class="card-text">Schedule tee times and manage daily bookings for up to 4 players.</p>
                    <a class="btn btn-primary" asp-page="/Bookings/Index">View Bookings</a>
                </div>
            </div>
        </div>
    </div>
</div>
