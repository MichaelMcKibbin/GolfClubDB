@page "{id:int}"
@model DeleteModel

@{
    ViewData["Title"] = "Delete Member";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="text-danger">@ViewData["Title"]</h1>
            <hr />

            <h3>Are you sure you want to delete this member?</h3>

            <dl class="row">
                <dt class="col-sm-2">Membership Number</dt>
                <dd class="col-sm-10">@Model.Member.MembershipNumber</dd>

                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@Model.Member.Name</dd>

                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@Model.Member.Email</dd>

                <dt class="col-sm-2">Gender</dt>
                <dd class="col-sm-10">@Model.Member.Gender</dd>

                <dt class="col-sm-2">Handicap</dt>
                <dd class="col-sm-10">@Model.Member.Handicap</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="Member.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
